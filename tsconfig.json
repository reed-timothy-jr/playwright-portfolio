{
	"compilerOptions": {
		"declaration": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2022", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"resolveJsonModule": true,
		"rootDir": "./",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022"
	},
	"exclude": ["node_modules", "dist", "playwright-report", "test-results"],
	"include": ["src/**/*", "tests/**/*", "scripts/**/*", "playwright.config.ts"]
}
