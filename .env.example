# ── Web-app target (e2e, perf, sec, a11y pillars) ─────────────────────────
# Leave unset to run against the bundled fixture demo app (deterministic,
# offline-safe — the default). Set to your own app's URL to run the same
# specs against a real target (it must expose a compatible login flow).
# BASE_URL=https://your-app.example.com

# ── API target (api pillar) ───────────────────────────────────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com

# ── Database lanes (db pillar) ────────────────────────────────────────────
# Leave unset for the PGlite lane (in-process Postgres, no infra needed).
# Set all four to run the same specs against a real Postgres (integration lane).
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=powerbase
# DB_PASSWORD=change-me
# DB_NAME=powerbase_test
# DB_SSL=false

# ── Optional knobs ────────────────────────────────────────────────────────
# Perf budget for page load, ms (perf pillar)
# PERF_BUDGET_LOAD_MS=4000

# Login credentials for the target app (auth setup)
# APP_USER=tomsmith
# APP_PASSWORD=SuperSecretPassword!

# Optional: AI healing provider key (pluggable — see src/support/selfHealing.ts)
# POWERBASE_AI_API_KEY=
