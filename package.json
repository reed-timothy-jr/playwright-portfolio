{
	"author": "Timothy Reed",
	"description": "PowerBase Playwright Framework \u2014 senior-grade Playwright + TypeScript starter: self-healing locators, chaos engineering, API/DB layers, Docker, CI.",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.55.0",
		"@types/node": "^22.0.0",
		"dotenv": "^16.4.5",
		"typescript": "^5.6.0"
	},
	"keywords": [
		"playwright",
		"typescript",
		"test-automation",
		"qa",
		"self-healing",
		"chaos-engineering"
	],
	"license": "MIT",
	"name": "powerbase-playwright-framework",
	"scripts": {
		"report": "playwright show-report",
		"test": "playwright test",
		"test:api": "playwright test tests/api --project=chromium",
		"test:resilience": "playwright test tests/resilience --project=chromium",
		"test:smoke": "playwright test tests/smoke --project=chromium",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"type": "commonjs",
	"version": "0.1.0",
	"dependencies": {
		"zod": "^4.6.5"
	}
}
