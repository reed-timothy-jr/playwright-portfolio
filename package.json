{
	"author": "Timothy Reed",
	"description": "PowerBase Playwright Framework — five-pillar test framework (e2e, api, db, perf, sec) with a supporting layer: self-healing locators, chaos engineering, typed API client, evidence capture. Base framework for enterprise apps.",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.55.0",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.23.1",
		"dotenv": "^16.4.5",
		"tsx": "^4.23.15",
		"typescript": "^5.6.0"
	},
	"keywords": [
		"playwright",
		"typescript",
		"test-automation",
		"qa",
		"e2e-testing",
		"api-testing",
		"database-testing",
		"performance-testing",
		"security-testing",
		"self-healing",
		"chaos-engineering"
	],
	"license": "MIT",
	"name": "playwright-portfolio",
	"scripts": {
		"report": "playwright show-report",
		"report:flakiness": "node scripts/report-flakiness.mjs",
		"test": "npm run test:pillars",
		"test:e2e": "playwright test --project=e2e --project=e2e-auth",
		"test:api": "playwright test --project=api",
		"test:db": "playwright test --project=db",
		"test:perf": "playwright test --project=perf",
		"test:sec": "playwright test --project=sec",
		"test:pillars": "playwright test --project=e2e --project=e2e-auth --project=api --project=db --project=perf --project=sec",
		"test:proof": "playwright test --project=proof",
		"test:unit": "playwright test --project=unit",
		"test:support": "playwright test --project=a11y --project=visual",
		"test:all": "playwright test --project=e2e --project=e2e-auth --project=api --project=db --project=perf --project=sec --project=a11y --project=visual --project=unit",
		"verify": "npm run lint && npm run typecheck && npm run test:all",
		"audit:sec": "npm audit --audit-level=high",
		"audit:a11y": "tsx scripts/a11y-audit.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"recon": "tsx scripts/recon.ts",
		"scaffold": "tsx scripts/scaffold.ts"
	},
	"type": "commonjs",
	"version": "0.1.0",
	"dependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@electric-sql/pglite": "^0.5.8",
		"pg": "^8.23.1",
		"zod": "^4.6.5"
	}
}
